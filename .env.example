# EVM address that receives USDC payments (your wallet, NOT a private key)
PAY_TO=0xYourWalletAddress
# eip155:84532 = Base Sepolia (testnet), eip155:8453 = Base mainnet
NETWORK=eip155:84532
# Free testnet facilitator. For mainnet use Coinbase CDP's facilitator.
FACILITATOR_URL=https://x402.org/facilitator
PORT=4021
# X402_DISABLED=1   # local dev only: serves paid endpoints for free

# ---- test client (npm run client) ----
# Private key of a SEPARATE TEST wallet that pays (create one: npm run wallet:new)
CLIENT_PRIVATE_KEY=
CLIENT_MAX_USD=0.05          # client refuses to pay more than this per request
# CLIENT_ALLOW_MAINNET=1     # required to spend real USDC on Base mainnet

# ---- server tuning ----
# CACHE_TTL_MS=30000        # cache Polymarket responses this long
# FREE_RATE_PER_MIN=60      # per-IP limit on free endpoints
# DB_PATH=data/payments.db  # payment ledger (SQLite)

# ---- production ----
# NODE_ENV=production       # refuses X402_DISABLED
# TRUST_PROXY=fly           # none | xff | fly — where the client IP comes from (rate limit)
# Mainnet (NETWORK=eip155:8453) needs Coinbase CDP facilitator keys:
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# Mainnet without keys: FACILITATOR_URL=https://facilitator.payai.network
